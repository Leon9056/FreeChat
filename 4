:root{--bg:#080b14;--panel:#101522;--panel2:#151b2b;--line:#252d40;--text:#f5f7fb;--muted:#9aa5ba;--accent:#7c5cff;--accent2:#5eead4;--danger:#fb7185;--warn:#fbbf24;--ok:#34d399;--shadow:0 18px 50px rgba(0,0,0,.28)}*{box-sizing:border-box}body{margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,sans-serif;background:radial-gradient(900px 500px at 70% -10%,#20204a 0,transparent 60%),var(--bg);color:var(--text)}button,input,select{font:inherit}button{cursor:pointer}.hidden{display:none!important}.login{min-height:100vh;display:grid;place-items:center;padding:24px}.login-card{width:min(430px,100%);background:rgba(16,21,34,.92);border:1px solid var(--line);border-radius:24px;padding:32px;box-shadow:var(--shadow)}.brand{display:flex;gap:12px;align-items:center;margin-bottom:28px}.logo{width:46px;height:46px;border-radius:14px;background:linear-gradient(135deg,var(--accent),#4f46e5);display:grid;place-items:center;font-weight:900}.brand h1{font-size:20px;margin:0}.brand small{color:var(--muted)}h2,h3,p{margin-top:0}.field{margin:16px 0}.field label{display:block;font-size:13px;color:var(--muted);margin-bottom:7px}.field input,.field select{width:100%;background:#0b1020;border:1px solid var(--line);color:var(--text);border-radius:12px;padding:12px 13px;outline:none}.field input:focus,.field select:focus{border-color:var(--accent)}.primary{width:100%;border:0;border-radius:12px;padding:13px;color:white;font-weight:750;background:linear-gradient(135deg,var(--accent),#5b4be7)}.note{color:var(--muted);font-size:12px;line-height:1.5;margin-top:15px}.shell{display:grid;grid-template-columns:250px 1fr;min-height:100vh}.side{border-right:1px solid var(--line);padding:22px 14px;background:rgba(9,13,24,.8);position:sticky;top:0;height:100vh}.side .brand{padding:0 8px}.nav{display:grid;gap:6px;margin-top:25px}.nav button{border:1px solid transparent;background:transparent;color:var(--muted);padding:11px 12px;border-radius:11px;text-align:left}.nav button:hover,.nav button.active{background:var(--panel2);color:var(--text);border-color:var(--line)}.side-footer{position:absolute;bottom:18px;left:18px;right:18px}.logout{width:100%;border:1px solid var(--line);background:transparent;color:var(--muted);padding:10px;border-radius:10px}.main{min-width:0}.top{height:76px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 28px;position:sticky;top:0;background:rgba(8,11,20,.84);backdrop-filter:blur(16px);z-index:5}.top .status{display:flex;gap:9px;align-items:center;color:var(--muted);font-size:13px}.dot{width:8px;height:8px;border-radius:50%;background:var(--ok);box-shadow:0 0 14px var(--ok)}.content{padding:28px;max-width:1500px;margin:auto}.page-title{display:flex;justify-content:space-between;gap:20px;align-items:end;margin-bottom:22px}.page-title h2{margin:0 0 6px;font-size:28px}.page-title p{margin:0;color:var(--muted)}.cards{display:grid;grid-template-columns:repeat(4,1fr);gap:15px}.card{background:linear-gradient(180deg,rgba(21,27,43,.95),rgba(14,19,31,.95));border:1px solid var(--line);border-radius:17px;padding:19px;box-shadow:0 8px 30px rgba(0,0,0,.12)}.metric{font-size:29px;font-weight:800;margin:8px 0}.muted{color:var(--muted)}.trend{font-size:12px;color:var(--ok)}.grid2{display:grid;grid-template-columns:1.4fr 1fr;gap:16px;margin-top:16px}.section{background:var(--panel);border:1px solid var(--line);border-radius:17px;overflow:hidden}.section-head{padding:17px 18px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center}.section-head h3{margin:0;font-size:15px}.table-wrap{overflow:auto}table{width:100%;border-collapse:collapse;min-width:650px}th,td{text-align:left;padding:13px 16px;border-bottom:1px solid var(--line);font-size:13px}th{color:var(--muted);font-weight:650;background:#0e1422}tr:last-child td{border-bottom:0}.badge{display:inline-flex;padding:5px 8px;border-radius:999px;font-size:11px;font-weight:700}.ok{background:rgba(52,211,153,.12);color:var(--ok)}.warn{background:rgba(251,191,36,.12);color:var(--warn)}.danger{background:rgba(251,113,133,.12);color:var(--danger)}.info{background:rgba(124,92,255,.14);color:#b7a9ff}.toolbar{display:flex;gap:9px;flex-wrap:wrap}.toolbar input,.toolbar select{background:#0b1020;border:1px solid var(--line);color:var(--text);padding:9px 11px;border-radius:10px}.small-btn{border:1px solid var(--line);background:#12192a;color:var(--text);padding:7px 9px;border-radius:9px;font-size:12px}.small-btn.danger-btn{color:#ff9aaa}.empty{padding:35px;text-align:center;color:var(--muted)}.chart{height:230px;padding:20px;display:flex;align-items:end;gap:10px}.bar{flex:1;border-radius:7px 7px 2px 2px;background:linear-gradient(180deg,var(--accent),#4035a4);min-height:10px}.bar-label{font-size:10px;color:var(--muted);text-align:center;margin-top:6px}.bar-col{flex:1;height:100%;display:flex;flex-direction:column;justify-content:end}.settings{display:grid;gap:12px;padding:18px}.setting{display:flex;justify-content:space-between;gap:20px;align-items:center;padding:15px;border:1px solid var(--line);border-radius:12px;background:#0d1320}.switch{width:45px;height:25px;border-radius:20px;background:#30384d;padding:3px}.switch.on{background:var(--accent)}.switch i{display:block;width:19px;height:19px;border-radius:50%;background:white;transition:.2s}.switch.on i{transform:translateX(20px)}.toast{position:fixed;right:20px;bottom:20px;background:#111827;border:1px solid var(--line);padding:12px 15px;border-radius:12px;box-shadow:var(--shadow);z-index:20}.mobile-menu{display:none}
@media(max-width:1000px){.cards{grid-template-columns:repeat(2,1fr)}.grid2{grid-template-columns:1fr}.shell{grid-template-columns:78px 1fr}.side .brand h1,.side .brand small,.nav button span,.side-footer .logout span{display:none}.side .brand{justify-content:center}.nav button{text-align:center}.side-footer{left:12px;right:12px}.content{padding:20px}}
@media(max-width:650px){.shell{display:block}.side{position:fixed;z-index:10;left:-270px;width:250px;transition:.2s}.side.open{left:0}.side .brand h1,.side .brand small,.nav button span,.side-footer .logout span{display:block}.top{padding:0 15px}.mobile-menu{display:block;border:1px solid var(--line);background:var(--panel);color:var(--text);border-radius:9px;padding:8px 10px}.content{padding:16px}.cards{grid-template-columns:1fr 1fr;gap:10px}.card{padding:14px}.metric{font-size:24px}.page-title{display:block}.page-title .toolbar{margin-top:14px}.login-card{padding:25px}}
