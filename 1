

(()=>{
const C=window.FREECHAT_CONFIG||{},API=String(C.API_URL||'').replace(/\/$/,''),state={token:localStorage.getItem('fcToken')||'',user:JSON.parse(localStorage.getItem('fcUser')||'null'),mode:'login',page:'home',friends:[],selected:null,messages:[],socket:null,media:null,pc:null,call:null,remote:null,maintenance:false};
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));
const initials=n=>String(n||'?').split(/\s+/).map(x=>x[0]).slice(0,2).join('').toUpperCase();
function toast(t){const e=document.createElement('div');e.className='toast';e.textContent=t;document.body.appendChild(e);setTimeout(()=>e.remove(),2600)}
async function api(path,opt={}){if(!API)return null;try{const r=await fetch(API+path,{...opt,headers:{'Content-Type':'application/json',...(opt.headers||{}),...(state.token?{Authorization:'Bearer '+state.token}:{})}});const d=await r.json().catch(()=>({}));if(r.status===401){localStorage.removeItem('fcToken');localStorage.removeItem('fcUser');state.token='';state.user=null}if(!r.ok)throw Error(d.error||'request_failed');return d}catch(e){return {__error:e.message}}}
function login(){document.getElementById('app').innerHTML=`<main class="login"><section class="login-card"><div class="brand"><div class="logo">FC</div><div><h1>FreeChat</h1><small>Comunicação em tempo real</small></div></div><div class="tabs"><button id="loginTab" class="${state.mode==='login'?'active':''}">Entrar</button><button id="registerTab" class="${state.mode==='register'?'active':''}">Criar conta</button></div><form id="authForm">${state.mode==='register'?'<div class="field"><label>Nome</label><input id="name" maxlength="24" required></div>':''}<div class="field"><label>E-mail</label><input id="email" type="email" maxlength="120" required></div><div class="field"><label>Senha</label><div class="password-wrap"><input id="password" type="password" maxlength="64" required><button class="eye" id="eye" type="button">◉</button></div></div>${state.mode==='register'?'<div class="field"><label>Confirmar senha</label><input id="confirm" type="password" maxlength="64" required></div>':''}<button class="primary" id="authBtn">${state.mode==='register'?'Criar conta':'Entrar'}</button><div id="authStatus" class="status"></div></form><div class="note">${API?'API configurada.':'Configure a URL da API em client/config.js antes de publicar.'}</div></section></main>`;
$('loginTab').onclick=()=>{state.mode='login';login()};$('registerTab').onclick=()=>{state.mode='register';login()};$('eye').onclick=()=>{const p=$('password');p.type=p.type==='password'?'text':'password'};
$('authForm').onsubmit=async e=>{e.preventDefault();const btn=$('authBtn'),st=$('authStatus');btn.disabled=true;st.className='status';st.textContent='Conectando...';const email=$('email').value.trim(),password=$('password').value,body={email,password};if(state.mode==='register'){body.name=$('name').value.trim();if(password!==$('confirm').value){st.className='status err';st.textContent='As senhas não coincidem.';btn.disabled=false;return}}
let d=await api(state.mode==='register'?'/api/register':'/api/login',{method:'POST',body:JSON.stringify(body)});if(d?.token){save(d);showApp()}else if(C.DEMO_MODE){save({token:'demo-token',user:{id:'demo',name:body.name||'Você',email,code:'FC-DEMO',status:'active'}});showApp();toast('Modo demonstração')}else{st.className='status err';st.textContent=msg(d?.__error||d?.error)}btn.disabled=false};}
function $(id){return document.getElementById(id)}function msg(x){return ({invalid_data:'Preencha os dados corretamente.',email_exists:'Este e-mail já está cadastrado.',invalid_credentials:'E-mail ou senha incorretos.',suspended:'Sua conta está suspensa.',maintenance:'O serviço está em manutenção.',database_unavailable:'Banco de dados indisponível.'}[x]||'Não foi possível concluir a operação.')}
function save(d){state.token=d.token;state.user=d.user;localStorage.setItem('fcToken',state.token);localStorage.setItem('fcUser',JSON.stringify(state.user))}
function logout(){state.socket?.disconnect();state.media?.getTracks().forEach(t=>t.stop());state.pc?.close();state.token='';state.user=null;localStorage.removeItem('fcToken');localStorage.removeItem('fcUser');login()}
function layout(){document.getElementById('app').innerHTML=`<div class="shell"><aside class="side" id="side"><div class="brand"><div class="logo">FC</div><div><h1>FreeChat</h1><small>${esc(state.user.code)}</small></div></div><nav class="nav">${[['home','⌂','Início'],['friends','♙','Amigos'],['chat','◌','Mensagens'],['calls','⌁','Chamadas'],['streams','▶','Streams'],['settings','⚙','Configurações']].map(x=>`<button data-page="${x[0]}" class="${state.page===x[0]?'active':''}">${x[1]} <span>${x[2]}</span></button>`).join('')}</nav><div class="side-footer"><button class="logout" id="logout">↪ Sair</button></div></aside><main class="main"><header class="top"><button class="mobile-menu" id="menu">☰</button><b>FreeChat</b><div class="system"><i class="dot"></i><span id="systemText">Online</span></div></header><section class="content" id="content"></section></main></div>`;document.querySelectorAll('[data-page]').forEach(b=>b.onclick=()=>{state.page=b.dataset.page;$('side').classList.remove('open');renderPage()});$('logout').onclick=logout;$('menu').onclick=()=>$('side').classList.toggle('open');renderPage();loadStatus();loadFriends();connectSocket()}
function renderPage(){({home,friends,chat,calls,streams,settings}[state.page]||home)()}
async function loadStatus(){const d=await api('/api/public/status');if(d&&!d.__error){state.maintenance=!!d.maintenance;if($('systemText'))$('systemText').textContent=state.maintenance?'Manutenção':'Online'}}
async function loadFriends(){const d=await api('/api/friends');if(Array.isArray(d))state.friends=d; if(state.page==='friends')drawFriends()}
function home(){const u=state.user;document.getElementById('content').innerHTML=`<div class="page-title"><div><h2>Olá, ${esc(u.name)} 👋</h2><p>Seu espaço de comunicação.</p></div></div>${state.maintenance?'<div class="maintenance">⚠️ O sistema está em manutenção.</div>':''}<div class="cards"><div class="card"><span class="muted">Seu código</span><div class="metric">${esc(u.code)}</div></div><div class="card"><span class="muted">Amigos</span><div class="metric">${state.friends.length}</div></div><div class="card"><span class="muted">Conta</span><div class="metric">${u.status==='active'?'Ativa':'Suspensa'}</div></div><div class="card"><span class="muted">Serviço</span><div class="metric">${state.maintenance?'Manutenção':'Online'}</div></div></div><section class="panel"><div class="panel-head"><h3>Ações rápidas</h3></div><div class="section-pad"><div class="quick"><button onclick="go('friends')">♙ Amigos<br><small class="muted">Adicionar pelo código</small></button><button onclick="go('chat')">◌ Mensagens<br><small class="muted">Conversar</small></button><button onclick="go('calls')">⌁ Chamadas<br><small class="muted">Áudio/vídeo</small></button><button onclick="go('streams')">▶ Streams<br><small class="muted">Transmissões</small></button></div></div></section>`}
function friends(){document.getElementById('content').innerHTML=`<div class="page-title"><div><h2>Amigos</h2><p>Use o código FreeChat para adicionar alguém.</p></div><button class="small" id="addFriend">＋ Adicionar</button></div><section class="panel"><div class="panel-head"><h3>Minha lista</h3><input class="search" id="friendSearch" placeholder="Buscar"></div><div class="list" id="friendList"></div></section>`;$('addFriend').onclick=addFriend; $('friendSearch').oninput=()=>drawFriends($('friendSearch').value);drawFriends()}
function drawFriends(q=''){const l=$('friendList');if(!l)return;const a=state.friends.filter(f=>(f.name+' '+f.email+' '+f.code).toLowerCase().includes(q.toLowerCase()));l.innerHTML=a.map(f=>`<div class="item"><div class="avatar">${initials(f.name)}</div><div class="item-main"><b>${esc(f.name)}</b><small>${esc(f.code)} • ${f.status==='active'?'Ativo':'Suspenso'}</small></div><button class="small" onclick="openChat('${esc(f.id)}')">Mensagem</button></div>`).join('')||'<div class="empty">Nenhum amigo.</div>'}
function addFriend(){modal(`<div class="modal-head"><h3>Adicionar amigo</h3><button class="close" onclick="closeModal()">×</button></div><p class="muted">Digite o código da pessoa.</p><div class="field"><input id="friendCode" placeholder="FC-ABC123"></div><button class="primary" id="sendFriend">Enviar</button>`);$('sendFriend').onclick=async()=>{const d=await api('/api/friends/request',{method:'POST',body:JSON.stringify({code:$('friendCode').value.trim()})});if(d&&!d.__error){closeModal();toast('Solicitação enviada')}else toast(msg(d?.error||d?.__error))}}
function chat(){document.getElementById('content').innerHTML=`<div class="page-title"><div><h2>Mensagens</h2><p>Converse em tempo real.</p></div></div><div class="layout"><section class="panel chat"><div class="panel-head"><h3>${esc(state.selected?.name||'Selecione um amigo')}</h3></div><div class="messages" id="messages">${state.selected?'':'<div class="empty">Escolha um amigo.</div>'}</div><form class="composer" id="composer"><input id="msg" ${state.selected?'':'disabled'} placeholder="Escreva uma mensagem"><button class="icon-btn" ${state.selected?'':'disabled'}>➤</button></form></section><section class="panel"><div class="panel-head"><h3>Amigos</h3></div><div class="list">${state.friends.map(f=>`<div class="item" onclick="openChat('${esc(f.id)}')"><div class="avatar">${initials(f.name)}</div><div class="item-main"><b>${esc(f.name)}</b><small>${esc(f.code)}</small></div></div>`).join('')}</div></section></div>`;$('composer').onsubmit=e=>{e.preventDefault();const v=$('msg').value.trim();if(v&&state.selected){sendMessage(v);$('msg').value=''}};if(state.selected){state.messages.filter(m=>m.friendId===String(state.selected.id)).forEach(renderMessage)}}
function openChat(id){state.selected=state.friends.find(f=>String(f.id)===String(id));state.page='chat';renderPage()}
function sendMessage(text){const m={friendId:String(state.selected.id),text,time:new Date().toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'}),me:true};state.messages.push(m);renderMessage(m);state.socket?.emit('chat-message',{to:String(state.selected.id),text})}
function renderMessage(m){const b=$('messages');if(!b)return;const e=document.createElement('div');e.className='bubble '+(m.me?'me':'');e.innerHTML=esc(m.text)+`<small>${esc(m.time||'agora')}</small>`;b.appendChild(e);b.scrollTop=b.scrollHeight}
function calls(){document.getElementById('content').innerHTML=`<div class="page-title"><div><h2>Chamadas</h2><p>Chamadas 1:1 com WebRTC.</p></div><div><select class="search" id="callFriend"><option value="">Escolha um amigo</option>${state.friends.map(f=>`<option value="${esc(f.id)}">${esc(f.name)}</option>`).join('')}</select><button class="small" onclick="startCall('audio')">📞 Áudio</button><button class="small" onclick="startCall('video')">🎥 Vídeo</button></div></div><section class="panel"><div class="panel-head"><h3 id="callState">Nenhuma chamada</h3></div><div class="call-grid" id="callGrid"><div class="empty">Escolha um amigo e inicie.</div></div><div class="call-actions"><button class="small" onclick="toggleMic()">🎙️ Microfone</button><button class="small" onclick="toggleCam()">📷 Câmera</button><button class="small" onclick="shareScreen()">🖥️ Tela</button><button class="small danger" onclick="endCall()">Encerrar</button></div></section>`}
async function startCall(type){const fid=$('callFriend')?.value;if(!fid)return toast('Escolha um amigo.');if(state.maintenance)return toast('Chamadas indisponíveis durante manutenção.');const f=state.friends.find(x=>String(x.id)===fid);try{state.media=await navigator.mediaDevices.getUserMedia({audio:true,video:type==='video'});state.call={id:'call_'+crypto.randomUUID(),peerId:fid,type,initiator:true};state.pc=makePeer(fid);state.media.getTracks().forEach(t=>state.pc.addTrack(t,state.media));localVideo();state.socket?.emit('call-invite',{to:fid,callId:state.call.id,type});$('callState').textContent='Chamando '+f.name+'…'}catch(e){toast('Não foi possível acessar câmera/microfone.')}}
function makePeer(peerId){const pc=new RTCPeerConnection({iceServers:[{urls:'stun:stun.l.google.com:19302'},{urls:'stun:stun1.l.google.com:19302'}]});pc.onicecandidate=e=>{if(e.candidate)state.socket?.emit('webrtc-ice',{to:peerId,callId:state.call.id,candidate:e.candidate})};pc.ontrack=e=>{if(!state.remote){const v=document.createElement('div');v.className='video';v.innerHTML='<video id="remoteVideo" autoplay playsinline></video><span>Remoto</span>';$('callGrid').appendChild(v);state.remote=$('remoteVideo')}state.remote.srcObject=e.streams[0]};pc.onconnectionstatechange=()=>{if(['failed','disconnected','closed'].includes(pc.connectionState))toast('Conexão da chamada perdida.')};return pc}
function localVideo(){const g=$('callGrid');g.innerHTML='<div class="video"><video id="localVideo" autoplay muted playsinline></video><span>Você</span></div>';if(state.remote){g.insertAdjacentHTML('beforeend','<div class="video"><video id="remoteVideo" autoplay playsinline></video><span>Remoto</span></div>');state.remote=$('remoteVideo')}$('localVideo').srcObject=state.media}
async function acceptCall(m){if(state.media)return;state.call={id:m.callId,peerId:m.from,type:m.type,initiator:false};state.media=await navigator.mediaDevices.getUserMedia({audio:true,video:m.type==='video'});state.pc=makePeer(m.from);state.media.getTracks().forEach(t=>state.pc.addTrack(t,state.media));state.page='calls';renderPage();localVideo();$('callState').textContent='Em chamada';state.socket?.emit('call-accept',{to:m.from,callId:m.callId})}
function toggleMic(){const t=state.media?.getAudioTracks()[0];if(t)t.enabled=!t.enabled;else toast('Nenhuma chamada ativa.')}
function toggleCam(){const t=state.media?.getVideoTracks()[0];if(t)t.enabled=!t.enabled;else toast('Esta chamada não usa vídeo.')}
async function shareScreen(){if(!state.media||!state.pc)return toast('Entre em uma chamada primeiro.');try{const s=await navigator.mediaDevices.getDisplayMedia({video:true});const st=s.getVideoTracks()[0],sender=state.pc.getSenders().find(x=>x.track?.kind==='video');if(sender)sender.replaceTrack(st);else state.pc.addTrack(st,state.media);const v=$('localVideo');if(v)v.srcObject=s;st.onended=()=>{const cam=state.media.getVideoTracks()[0];const snd=state.pc.getSenders().find(x=>x.track?.kind==='video');if(snd&&cam)snd.replaceTrack(cam);if(v)v.srcObject=state.media}}catch{} }
function endCall(){if(state.call)state.socket?.emit('call-end',{callId:state.call.id,to:state.call.peerId});state.pc?.close();state.media?.getTracks().forEach(t=>t.stop());state.pc=null;state.media=null;state.call=null;state.remote=null;const g=$('callGrid');if(g)g.innerHTML='<div class="empty">Nenhuma chamada ativa.</div>';const s=$('callState');if(s)s.textContent='Nenhuma chamada';toast('Chamada encerrada')}
function streams(){document.getElementById('content').innerHTML=`<div class="page-title"><div><h2>Streams</h2><p>Área de transmissões.</p></div></div><section class="panel"><div class="empty">Streams serão ativados na próxima etapa. A estrutura administrativa já está preparada.</div></section>`}
function settings(){document.getElementById('content').innerHTML=`<div class="page-title"><div><h2>Configurações</h2></div></div><section class="panel"><div class="section-pad"><div class="field"><label>Nome</label><input id="setName" value="${esc(state.user.name)}"></div><div class="field"><label>E-mail</label><input value="${esc(state.user.email)}" disabled></div><div class="field"><label>Código</label><input value="${esc(state.user.code)}" disabled></div><button class="primary" id="saveSettings">Salvar</button></div></section>`;$('saveSettings').onclick=async()=>{const d=await api('/api/me',{method:'PATCH',body:JSON.stringify({name:$('setName').value})});if(d?.user){state.user=d.user;localStorage.setItem('fcUser',JSON.stringify(state.user));toast('Perfil atualizado')}}}
function modal(html){const e=document.createElement('div');e.className='modal';e.id='modal';e.innerHTML=`<div class="modal-card">${html}</div>`;document.body.appendChild(e)}function closeModal(){$('modal')?.remove()}
function connectSocket(){if(!API||!state.token||state.token==='demo-token')return;const s=document.createElement('script');s.src=API+'/socket.io/socket.io.js';s.onload=()=>{if(!window.io)return;state.socket=window.io(API,{auth:{token:state.token},transports:['websocket','polling']});state.socket.on('connect_error',()=>toast('Não foi possível conectar ao servidor em tempo real.'));state.socket.on('presence',d=>{state.online=d||[]});state.socket.on('chat-message',m=>{const f=state.friends.find(x=>String(x.id)===String(m.from));if(f){const x={friendId:String(m.from),text:m.text,me:false,time:'agora'};state.messages.push(x);if(state.selected&&String(state.selected.id)===String(m.from))renderMessage(x)}});state.socket.on('call-invite',m=>{const f=state.friends.find(x=>String(x.id)===String(m.from));if(confirm((f?.name||'Alguém')+' está ligando. Aceitar?'))acceptCall(m)});state.socket.on('call-accept',async()=>{if(!state.call||!state.pc)return;const offer=await state.pc.createOffer();await state.pc.setLocalDescription(offer);state.socket.emit('webrtc-offer',{to:state.call.peerId,callId:state.call.id,offer})});state.socket.on('webrtc-offer',async m=>{if(!state.pc)return;await state.pc.setRemoteDescription(m.offer);const a=await state.pc.createAnswer();await state.pc.setLocalDescription(a);state.socket.emit('webrtc-answer',{to:m.from,callId:m.callId,answer:a})});state.socket.on('webrtc-answer',async m=>{if(state.pc)await state.pc.setRemoteDescription(m.answer)});state.socket.on('webrtc-ice',async m=>{try{if(state.pc&&m.candidate)await state.pc.addIceCandidate(m.candidate)}catch{}});state.socket.on('call-end',()=>{if(state.call)endCall()});state.socket.on('admin-action',a=>{if(a.type==='suspend'){toast('Sua conta foi suspensa pelo administrador.');logout()}if(a.type==='call-end'&&state.call?.id===a.callId)endCall()})};s.onerror=()=>toast('API não encontrada: confira client/config.js')}
window.go=p=>{state.page=p;renderPage()};window.openChat=openChat;window.closeModal=closeModal;window.startCall=startCall;window.toggleMic=toggleMic;window.toggleCam=toggleCam;window.shareScreen=shareScreen;window.endCall=endCall;
async function boot(){if(!state.token||!state.user){login();return}if(API&&!state.token.startsWith('demo-')){const d=await api('/api/me');if(d?.user){state.user=d.user;localStorage.setItem('fcUser',JSON.stringify(state.user))}else{logout();return}}showApp()}
function showApp(){if(!state.token||!state.user)return login();layout()}
boot();
})();
