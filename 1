(()=>{
const C=window.FREECHAT_CONFIG||{};const API=(C.API_URL||'').replace(/\/$/,'');
const state={page:'home',token:localStorage.getItem('fcToken')||'',user:JSON.parse(localStorage.getItem('fcUser')||'null'),mode:'login',friends:[],selected:null,messages:[],users:[],online:[],socket:null,call:null,media:null,maintenance:false};
const demoFriends=[{id:'fc_1028',name:'Ana Souza',email:'ana@example.com',code:'ANA842',status:'active'},{id:'fc_1027',name:'Carlos Lima',email:'carlos@example.com',code:'CAR190',status:'active'},{id:'fc_1026',name:'Marina Alves',email:'marina@example.com',code:'MAR551',status:'suspended'}];
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));
const initials=n=>String(n||'?').split(/\s+/).map(x=>x[0]).slice(0,2).join('').toUpperCase();
function toast(t){const e=document.createElement('div');e.className='toast';e.textContent=t;document.body.appendChild(e);setTimeout(()=>e.remove(),2400)}
async function api(path,opt={}){if(!API)return null;try{const r=await fetch(API+path,{...opt,headers:{'Content-Type':'application/json',...(opt.headers||{}),...(state.token?{Authorization:'Bearer '+state.token}:{})}});const d=await r.json().catch(()=>({}));if(!r.ok)throw Error(d.error||'request_failed');return d}catch(e){return null}}
function login(){document.getElementById('app').innerHTML=`<main class="login"><section class="login-card"><div class="brand"><div class="logo">FC</div><div><h1>FreeChat</h1><small>Comunicação em tempo real</small></div></div><div class="tabs"><button id="loginTab" class="${state.mode==='login'?'active':''}">Entrar</button><button id="registerTab" class="${state.mode==='register'?'active':''}">Criar conta</button></div><form id="authForm">${state.mode==='register'?`<div class="field"><label>Nome de usuário</label><input id="name" maxlength="24" autocomplete="name" required placeholder="Como quer ser chamado?"></div>`:''}<div class="field"><label>E-mail</label><input id="email" type="email" maxlength="120" autocomplete="email" required placeholder="voce@email.com"></div><div class="field"><label>Senha</label><div class="password-wrap"><input id="password" type="password" maxlength="64" autocomplete="${state.mode==='register'?'new-password':'current-password'}" required placeholder="Digite sua senha"><button class="eye" id="eye" type="button" aria-label="Mostrar senha">◉</button></div>${state.mode==='register'?`<div class="strength"><span id="strength"></span></div>`:''}</div>${state.mode==='register'?`<div class="field"><label>Confirmar senha</label><input id="confirm" type="password" maxlength="64" autocomplete="new-password" required placeholder="Digite novamente"></div>`:''}<button class="primary" id="authBtn">${state.mode==='register'?'Criar conta':'Entrar'}</button><div id="authStatus" class="status"></div></form><p class="note">Sua conta pode ser administrada pelo painel FreeChat Admin. Contas suspensas não conseguem acessar o serviço.</p></section></main>`;
 document.getElementById('loginTab').onclick=()=>{state.mode='login';login()};document.getElementById('registerTab').onclick=()=>{state.mode='register';login()};document.getElementById('eye').onclick=()=>{const i=document.getElementById('password');i.type=i.type==='password'?'text':'password'};
 const pw=document.getElementById('password');pw?.addEventListener('input',()=>{const s=document.getElementById('strength');if(!s)return;let n=0,v=pw.value;if(v.length>=8)n++;if(/[A-Z]/.test(v))n++;if(/[0-9]/.test(v))n++;if(/[^A-Za-z0-9]/.test(v))n++;s.style.width=(n*25)+'%';s.style.background=n<2?'var(--danger)':n<4?'var(--warn)':'var(--ok)'});
 document.getElementById('authForm').onsubmit=async e=>{e.preventDefault();const btn=document.getElementById('authBtn'),st=document.getElementById('authStatus');btn.disabled=true;st.textContent='Conectando...';const body={email:email.value,password:password.value};if(state.mode==='register'){body.name=name.value;if(password.value!==confirm.value){st.className='status err';st.textContent='As senhas não coincidem.';btn.disabled=false;return}}const d=await api(state.mode==='register'?'/api/register':'/api/login',{method:'POST',body:JSON.stringify(body)});if(d?.token){saveSession(d);showApp()}else if(C.DEMO_MODE){saveSession({token:'demo-token',user:{id:'me',name:state.mode==='register'?(name?.value||'Você'):'Você',email:email.value,code:'FC-DEMO',status:'active'}});state.friends=[...demoFriends];showApp();toast('Modo demonstração ativo')}else{st.className='status err';st.textContent=d?.error==='suspended'?'Sua conta está suspensa.':'Não foi possível entrar.'}btn.disabled=false}}
function saveSession(d){state.token=d.token;state.user=d.user;localStorage.setItem('fcToken',state.token);localStorage.setItem('fcUser',JSON.stringify(state.user))}
function logout(){if(state.socket)state.socket.disconnect();localStorage.removeItem('fcToken');localStorage.removeItem('fcUser');state.token='';state.user=null;state.page='home';login()}
function layout(){document.getElementById('app').innerHTML=`<div class="shell"><aside class="side" id="side"><div class="brand"><div class="logo">FC</div><div><h1>FreeChat</h1><small>${esc(state.user?.code||'Conta')}</small></div></div><nav class="nav">${[['home','⌂','Início'],['friends','♙','Amigos'],['chat','◌','Mensagens'],['calls','⌁','Chamadas'],['streams','▶','Streams'],['settings','⚙','Configurações']].map(x=>`<button data-page="${x[0]}" class="${state.page===x[0]?'active':''}">${x[1]} <span>${x[2]}</span></button>`).join('')}</nav><div class="side-footer"><button class="logout" id="logout">↪ <span>Sair</span></button></div></aside><main class="main"><header class="top"><button class="mobile-menu" id="menu">☰</button><div class="top-title">FreeChat</div><div class="system"><i class="dot"></i><span id="systemText">Online</span></div></header><section class="content" id="content"></section></main></div>`;document.querySelectorAll('[data-page]').forEach(b=>b.onclick=()=>{state.page=b.dataset.page;document.getElementById('side').classList.remove('open');renderPage()});document.getElementById('logout').onclick=logout;document.getElementById('menu').onclick=()=>document.getElementById('side').classList.toggle('open');renderPage();loadStatus();connectSocket()}
function renderPage(){({home,dashboard:home,friends,chat,calls,streams,settings}[state.page]||home)()}
async function loadStatus(){const d=await api('/api/public/status');if(d){state.maintenance=!!d.maintenance;const e=document.getElementById('systemText');if(e)e.textContent=d.maintenance?'Manutenção':'Online';if(d.maintenance)toast('O FreeChat está em modo manutenção.')}}
function home(){const u=state.user||{};document.getElementById('content').innerHTML=`<div class="page-title"><div><h2>Olá, ${esc(u.name||'usuário')} 👋</h2><p>Seu espaço de comunicação no FreeChat.</p></div></div>${state.maintenance?'<div class="maintenance">⚠️ O sistema está em manutenção. Algumas funções podem estar temporariamente indisponíveis.</div>':''}<div class="cards"><div class="card"><span class="muted">Seu código</span><div class="metric">${esc(u.code||'FC-0000')}</div><span class="muted">Compartilhe com amigos</span></div><div class="card"><span class="muted">Amigos</span><div class="metric">${state.friends.length||0}</div><span class="muted">Conexões salvas</span></div><div class="card"><span class="muted">Status</span><div class="metric">${u.status==='suspended'?'Suspenso':'Ativo'}</div><span class="badge ${u.status==='suspended'?'danger':'ok'}">${u.status==='suspended'?'Acesso bloqueado':'Tudo certo'}</span></div><div class="card"><span class="muted">Serviço</span><div class="metric">${state.maintenance?'Manutenção':'Online'}</div><span class="muted">Protegido pelo Admin</span></div></div><div class="layout"><section class="panel"><div class="panel-head"><h3>Ações rápidas</h3></div><div class="section-pad"><div class="quick"><button onclick="window.go('friends')">♙ Gerenciar amigos<br><small class="muted">Adicionar e encontrar pessoas</small></button><button onclick="window.go('chat')">◌ Abrir mensagens<br><small class="muted">Continuar uma conversa</small></button><button onclick="window.go('calls')">⌁ Iniciar chamada<br><small class="muted">Áudio ou vídeo</small></button><button onclick="window.go('streams')">▶ Criar stream<br><small class="muted">Transmitir ao vivo</small></button></div></div></section><section class="panel"><div class="panel-head"><h3>Integração administrativa</h3><span class="badge ok">Ativa</span></div><div class="section-pad"><p class="muted">O FreeChat usa status de conta, chamadas, streams e manutenção compatíveis com o FreeChat Admin.</p><p class="muted">Se um administrador suspender sua conta ou encerrar uma sessão, a alteração é refletida no serviço.</p></div></section></div>`;loadFriends()}
function friends(){document.getElementById('content').innerHTML=`<div class="page-title"><div><h2>Amigos</h2><p>Encontre pessoas pelo código FreeChat.</p></div><div class="toolbar"><button class="small" id="addFriend">＋ Adicionar</button></div></div><div class="layout"><section class="panel"><div class="panel-head"><h3>Minha lista</h3><input class="search" id="friendSearch" placeholder="Buscar"></div><div class="list" id="friendList"></div></section><section class="panel"><div class="panel-head"><h3>Meu perfil</h3></div><div class="section-pad"><div class="avatar" style="width:64px;height:64px;font-size:22px">${initials(state.user?.name)}</div><h3>${esc(state.user?.name)}</h3><p class="muted">${esc(state.user?.email)}</p><span class="badge ok">${esc(state.user?.code)}</span></div></section></div>`;document.getElementById('addFriend').onclick=addFriendModal;document.getElementById('friendSearch').oninput=e=>drawFriends(e.target.value);drawFriends('');loadFriends()}
async function loadFriends(){const d=await api('/api/friends');if(Array.isArray(d))state.friends=d;else if(!state.friends.length)state.friends=[...demoFriends];if(state.page==='friends')drawFriends(document.getElementById('friendSearch')?.value||'')}
function drawFriends(q=''){const list=document.getElementById('friendList');if(!list)return;const arr=state.friends.filter(f=>(f.name+' '+f.email+' '+f.code).toLowerCase().includes(q.toLowerCase()));list.innerHTML=arr.map(f=>`<div class="item"><div class="avatar">${initials(f.name)}</div><div class="item-main"><b>${esc(f.name)}</b><small>${esc(f.code)} • ${f.status==='suspended'?'Suspenso':'Ativo'}</small></div><span class="online"></span><div class="friend-actions"><button class="small" onclick="window.openChat('${esc(f.id)}')">Mensagem</button></div></div>`).join('')||'<div class="empty">Nenhum amigo encontrado.</div>'}
function addFriendModal(){modal(`<div class="modal-head"><h3>Adicionar amigo</h3><button class="close" onclick="window.closeModal()">×</button></div><p class="muted">Digite o código FreeChat da pessoa.</p><div class="field"><label>Código</label><input id="friendCode" placeholder="FC-ABC123"></div><button class="primary" id="sendFriend">Enviar solicitação</button>`);document.getElementById('sendFriend').onclick=async()=>{const code=document.getElementById('friendCode').value.trim();const d=await api('/api/friends/request',{method:'POST',body:JSON.stringify({code})});if(d||C.DEMO_MODE){closeModal();toast('Solicitação enviada')}else toast('Não foi possível enviar')}}
function chat(){document.getElementById('content').innerHTML=`<div class="page-title"><div><h2>Mensagens</h2><p>Converse com seus amigos.</p></div></div><div class="layout"><section class="panel chat"><div class="panel-head"><h3>${esc(state.selected?.name||'Selecione um amigo')}</h3></div><div class="messages" id="messages">${state.selected?'<div class="empty">Comece a conversa.</div>':'<div class="empty">Escolha um amigo na lista para começar.</div>'}</div><form class="composer" id="composer"><input id="msg" ${state.selected?'':'disabled'} placeholder="Escreva uma mensagem..."><button class="icon-btn" ${state.selected?'':'disabled'}>➤</button></form></section><section class="panel"><div class="panel-head"><h3>Amigos</h3></div><div class="list">${state.friends.map(f=>`<div class="item" onclick="window.openChat('${esc(f.id)}')"><div class="avatar">${initials(f.name)}</div><div class="item-main"><b>${esc(f.name)}</b><small>${esc(f.code)}</small></div><span class="online"></span></div>`).join('')}</div></section></div>`;document.getElementById('composer').onsubmit=e=>{e.preventDefault();const v=document.getElementById('msg').value.trim();if(!v||!state.selected)return;sendMessage(v);document.getElementById('msg').value=''}}
function openChat(id){const f=state.friends.find(x=>String(x.id)===String(id));if(!f)return;state.selected=f;state.page='chat';renderPage();setTimeout(()=>{const m=document.getElementById('messages');m.innerHTML='';state.messages.filter(x=>x.friendId===f.id).forEach(renderMessage);},0)}
function sendMessage(text){const m={friendId:state.selected.id,from:state.user.name,text,time:new Date().toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'}),me:true};state.messages.push(m);renderMessage(m);if(state.socket)state.socket.emit('chat-message',{to:state.selected.id,text})}
function renderMessage(m){const box=document.getElementById('messages');if(!box)return;const e=document.createElement('div');e.className='bubble '+(m.me?'me':'');e.innerHTML=esc(m.text)+`<small>${esc(m.time||'agora')}</small>`;box.appendChild(e);box.scrollTop=box.scrollHeight}
function calls(){document.getElementById('content').innerHTML=`<div class="page-title"><div><h2>Chamadas</h2><p>Áudio e vídeo em tempo real.</p></div><div class="toolbar"><button class="small" onclick="window.startCall('audio')">📞 Áudio</button><button class="small" onclick="window.startCall('video')">🎥 Vídeo</button></div></div><section class="panel"><div class="panel-head"><h3>Sala de chamada</h3><span id="callState" class="badge warn">Nenhuma chamada</span></div><div class="call-grid" id="callGrid"><div class="empty">Inicie uma chamada para abrir a sala.</div></div><div class="call-actions"><button class="small" onclick="window.toggleMic()">🎙️ Microfone</button><button class="small" onclick="window.toggleCam()">📷 Câmera</button><button class="small" onclick="window.shareScreen()">🖥️ Tela</button><button class="small danger" onclick="window.endCall()">Encerrar</button></div></section>`}
async function startCall(type){if(state.maintenance){toast('Chamadas indisponíveis durante manutenção');return}try{state.media=await navigator.mediaDevices.getUserMedia({audio:true,video:type==='video'});state.call={id:'call_'+Math.random().toString(36).slice(2,8).toUpperCase(),type};drawLocalVideo();if(state.socket)state.socket.emit('call-start',{callId:state.call.id,type});document.getElementById('callState').textContent='Ao vivo';document.getElementById('callState').className='badge ok';toast('Chamada iniciada')}catch(e){toast('Permissão de câmera/microfone não concedida')}}
function drawLocalVideo(){const g=document.getElementById('callGrid');if(!g||!state.media)return;g.innerHTML=`<div class="video"><video id="localVideo" autoplay muted playsinline></video><span>${esc(state.user.name)} • você</span></div>`;document.getElementById('localVideo').srcObject=state.media}
function toggleMic(){if(!state.media)return toast('Entre em uma chamada primeiro');const t=state.media.getAudioTracks()[0];if(t){t.enabled=!t.enabled;toast(t.enabled?'Microfone ligado':'Microfone desligado')}}
function toggleCam(){if(!state.media)return toast('Entre em uma chamada primeiro');const t=state.media.getVideoTracks()[0];if(t){t.enabled=!t.enabled;toast(t.enabled?'Câmera ligada':'Câmera desligada')}}
async function shareScreen(){if(!state.media)return toast('Entre em uma chamada primeiro');if(!navigator.mediaDevices.getDisplayMedia)return toast('Compartilhamento não suportado');try{const s=await navigator.mediaDevices.getDisplayMedia({video:true});const st=s.getVideoTracks()[0];const old=state.media.getVideoTracks()[0];if(old)state.media.removeTrack(old);state.media.addTrack(st);document.getElementById('localVideo').srcObject=state.media;st.onended=()=>toast('Compartilhamento encerrado')}catch{}}
function endCall(){if(state.socket&&state.call)state.socket.emit('call-end',{callId:state.call.id});state.media?.getTracks().forEach(t=>t.stop());state.media=null;state.call=null;const g=document.getElementById('callGrid');if(g)g.innerHTML='<div class="empty">Nenhuma chamada ativa.</div>';const s=document.getElementById('callState');if(s){s.textContent='Nenhuma chamada';s.className='badge warn'}toast('Chamada encerrada')}
function streams(){document.getElementById('content').innerHTML=`<div class="page-title"><div><h2>Streams</h2><p>Transmissões ao vivo do FreeChat.</p></div><button class="small" onclick="window.startStream()">＋ Iniciar stream</button></div><section class="panel"><div class="panel-head"><h3>Ao vivo agora</h3><span class="badge ok">Tempo real</span></div><div class="call-grid"><div class="video"><div class="muted">Nenhuma transmissão carregada</div></div></div></section>`}
async function startStream(){if(state.maintenance)return toast('Streams indisponíveis durante manutenção');const d=await api('/api/streams',{method:'POST',body:JSON.stringify({title:'Stream de '+state.user.name})});if(d||C.DEMO_MODE)toast('Stream criado. A interface de transmissão será aberta na próxima etapa.');else toast('Não foi possível iniciar')}
function settings(){document.getElementById('content').innerHTML=`<div class="page-title"><div><h2>Configurações</h2><p>Preferências da sua conta.</p></div></div><section class="panel"><div class="section-pad"><div class="field"><label>Nome</label><input id="setName" value="${esc(state.user.name||'')}"></div><div class="field"><label>E-mail</label><input value="${esc(state.user.email||'')}" disabled></div><div class="field"><label>Código FreeChat</label><input value="${esc(state.user.code||'')}" disabled></div><button class="primary" id="saveSettings">Salvar alterações</button></div></section>`;document.getElementById('saveSettings').onclick=async()=>{const d=await api('/api/me',{method:'PATCH',body:JSON.stringify({name:document.getElementById('setName').value})});if(d?.user){state.user=d.user;localStorage.setItem('fcUser',JSON.stringify(state.user));toast('Perfil atualizado')}else if(C.DEMO_MODE){state.user.name=document.getElementById('setName').value;localStorage.setItem('fcUser',JSON.stringify(state.user));toast('Perfil atualizado')}}}
function modal(html){let e=document.createElement('div');e.className='modal';e.id='modal';e.innerHTML=`<div class="modal-card">${html}</div>`;document.body.appendChild(e)}function closeModal(){document.getElementById('modal')?.remove()}
function connectSocket(){if(!API||state.token.startsWith('demo-'))return;const s=document.createElement('script');s.src=API+'/socket.io/socket.io.js';s.onload=()=>{if(!window.io)return;state.socket=window.io(API,{auth:{token:state.token},transports:['websocket','polling']});state.socket.on('presence',d=>state.online=d||[]);state.socket.on('chat-message',m=>{if(state.selected&&String(m.from)===String(state.selected.id)){const x={text:m.text,me:false,time:'agora'};renderMessage(x)}});state.socket.on('admin-action',a=>{if(a.type==='suspend'){toast('Sua conta foi suspensa pelo administrador.');logout()}if(a.type==='call-end'&&state.call?.id===a.callId)endCall()})}}
window.go=p=>{state.page=p;renderPage()};window.openChat=openChat;window.closeModal=closeModal;window.startCall=startCall;window.toggleMic=toggleMic;window.toggleCam=toggleCam;window.shareScreen=shareScreen;window.endCall=endCall;window.startStream=startStream;
function showApp(){if(!state.token)return login();if(!state.user){logout();return}layout()}
if(state.token&&state.user)showApp();else login();
})();
