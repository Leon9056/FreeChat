<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#0a1020"><title>Conversa Live v1.7</title>
<link rel="stylesheet" href="style.css">
</head>
<body>
<section id="login" class="screen">
  <div class="auth-card">
    <div class="brand-icon">💬</div><h1>Conversa Live</h1>
    <p id="authSubtitle" class="muted">Entre na sua conta para continuar</p>
    <div class="auth-tabs"><button id="loginTab" class="auth-tab active" type="button">Entrar</button><button id="registerTab" class="auth-tab" type="button">Criar conta</button></div>
    <div id="registerFields" class="hidden"><label for="name">👤 Nome de usuário</label><input id="name" maxlength="24" autocomplete="name" placeholder="Como quer ser chamado?"></div>
    <label id="emailLabel" for="email">📧 E-mail</label><input id="email" type="email" maxlength="120" autocomplete="email" inputmode="email" placeholder="voce@email.com">
    <label id="passwordLabel" for="password">🔒 Senha</label><div class="password-wrap"><input id="password" type="password" maxlength="64" autocomplete="current-password" placeholder="Digite sua senha"><button id="togglePassword" class="icon-btn password-toggle" type="button" aria-label="Mostrar senha" aria-pressed="false"><span class="eye-icon" aria-hidden="true">◉</span></button></div>
    <div id="passwordStrength" class="password-strength hidden"><div class="strength-track"><span id="strengthBar"></span></div><span id="strengthText">Senha</span></div>
    <div id="confirmPasswordWrap" class="hidden"><label for="confirmPassword">🔐 Confirmar senha</label><div class="password-wrap"><input id="confirmPassword" type="password" maxlength="64" autocomplete="new-password" placeholder="Digite a senha novamente"><button id="toggleConfirmPassword" class="icon-btn password-toggle" type="button" aria-label="Mostrar confirmação da senha" aria-pressed="false"><span class="eye-icon" aria-hidden="true">◉</span></button></div></div>
    <button id="loginBtn" class="primary-btn" type="button">🚀 Entrar</button><div id="loginStatus" class="status" role="status" aria-live="polite"></div>
    <small class="auth-note">🔒 Sua senha é protegida no servidor. A confirmação em duas etapas adiciona uma camada extra de segurança.</small>
    <div id="twoFactorFields" class="hidden">
      <div class="twofa-icon">🛡️</div>
      <div class="twofa-title">Verificação em duas etapas</div>
      <p id="twoFactorHelp" class="muted twofa-help">Enviamos um código de 6 dígitos para o seu e-mail.</p>
      <input id="twoFactorCode" inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]*" placeholder="000000" aria-label="Código de verificação">
      <button id="verify2faBtn" class="primary-btn" type="button">✅ Verificar código</button>
      <button id="resend2faBtn" class="secondary-btn" type="button">📨 Reenviar código</button>
      <button id="back2faBtn" class="text-btn" type="button">← Voltar</button>
    </div>
  </div>
</section>
<section id="callMenu" class="screen hidden">
  <div class="call-menu-card">
    <div class="brand-icon">📞</div>
    <h1>Olá, <span id="welcomeName">usuário</span>! 👋</h1>
    <p class="muted">Crie uma chamada ou entre em uma existente.</p>
    <div class="profile-code"><span>Seu código de usuário</span><b id="myCode">CL-000000</b><button id="copyUserCode" type="button">📋 Copiar</button></div>
    <div class="friend-add-row"><input id="friendCodeInput" maxlength="20" placeholder="Código do amigo (ex.: CL-A1B2C3)"><button id="addFriendBtn" class="secondary-btn" type="button">➕ Adicionar</button></div>
    <div id="friendStatus" class="status"></div>
    <div class="friends-box"><div class="friends-title"><b>👥 Amigos</b><button id="refreshFriends" type="button">↻</button></div><div id="friendsList" class="friends-list"></div></div>

    <button id="createCallBtn" class="primary-btn big-btn">📞 Criar nova call</button>
    <button id="joinCallBtn" class="secondary-btn big-btn">🔗 Entrar em uma call</button>

    <div id="joinBox" class="join-box hidden">
      <label>🔑 Código da call</label>
      <input id="roomCodeInput" maxlength="32" placeholder="Ex.: ABC123">
      <button id="confirmJoinBtn" class="primary-btn">🎧 Entrar na call</button>
    </div>

    <div class="quick-emojis">😀 😎 🎮 🎤 🎥 🔥 ❤️ 🚀 👍 😂 🥳 👀 ✨</div>
    <div id="menuStatus" class="status"></div><button id="logoutBtn" class="logout-btn" type="button">Sair da conta</button>
  </div>
</section>

<div id="app" class="hidden">
<aside class="side">
  <div class="brand"><span class="mini">CL</span><b>Conversa Live</b></div>
  <div class="label">SALA</div><div class="room" id="roomName"># geral</div>
  <div class="status" id="status">Desconectado</div>
  <button id="invite" class="secondary">🔗 Copiar convite</button>
  <div class="label">PARTICIPANTES</div><div id="people"></div>
  <div class="me"><span id="avatar">?</span><div><b id="me">Você</b><small>Online</small></div></div>
</aside>
<div id="friendsPanel" class="friends-panel hidden"><div class="friends-panel-head"><b>👥 Amigos</b><button id="friendsClose" type="button">×</button></div><div class="friend-add-row"><input id="friendCodeApp" maxlength="20" placeholder="Código CL-XXXXXX"><button id="addFriendApp" class="secondary-btn" type="button">➕</button></div><div id="friendAppStatus" class="status"></div><div id="friendsAppList" class="friends-list"></div></div>
<main class="main">
<header><div><b># <span id="headRoom">geral</span></b><small>Conversa em tempo real</small></div>
<div class="header-actions"><div id="connectionMeter" class="connection-meter"><div class="connection-bars"><i></i><i></i><i></i><i></i><i></i></div><span id="connectionText">Conectando...</span></div><button id="callOpen">🎥 Call</button></div></header>
<section id="messages" class="messages"><div class="welcome">👋 Entre na conversa!</div></section>
<div id="emojiPicker" class="emoji-picker hidden" aria-label="Seletor de emojis">
  <div class="emoji-picker-head">
    <b>Emojis</b>
    <button type="button" id="emojiClose" class="emoji-close">×</button>
  </div>
  <input id="emojiSearch" class="emoji-search" placeholder="Pesquisar emoji..." autocomplete="off">
  <div class="emoji-tabs" id="emojiTabs"></div>
  <div class="emoji-grid" id="emojiGrid"></div>
</div>
<form id="form" class="composer"><button type="button" id="emoji" class="tool" title="Emojis">☺</button><input id="msg" maxlength="1000" autocomplete="off" placeholder="Escreva uma mensagem..."><button type="submit" class="send" title="Enviar">➤</button></form>
</main>

<section id="call" class="call hidden">
 <div class="callHead"><b>🎥 Chamada</b><button id="callClose">×</button></div>
 <div id="videos" class="videos"></div>
 <div class="controls">
  <button id="mic" title="Microfone">🎙️ <span>Microfone</span></button>
  <button id="cam" title="Câmera">📷 <span>Câmera</span></button>
  <button id="screen" title="Compartilhar tela">🖥️ <span>Tela</span></button>
  <button id="audioUnlock" class="audio-global hidden" title="Ativar áudio">🔊 <span>Ativar áudio</span></button>
  <button id="hang" class="danger" title="Sair da chamada">☎ <span>Sair</span></button>
 </div>
 <div id="callStatus" class="callStatus">Pronto.</div>
</section>
</div>
<script src="config.js"></script><script src="app.js"></script>
</body></html>
